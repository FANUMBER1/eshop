<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../common/admin/header.ejs') %>

    <style>
      body, html {
          height: 100%;
          margin: 0;
      }
      .container-fluid {
          height: 100%;
      }
      .row {
          height: 100%;
      }
      .position-fixed {
          height: 100vh;
      }
      .main-content {
          margin-left: 250px; /* Điều chỉnh theo chiều rộng của sidebar */
          padding: 20px;
      }
  </style>
  
</head>
<body>
  <%- include('../common/admin/siderbaadmin.ejs') %>

  <div class="main-content ml-2 col-10" >
    <div class="row text-center">
      <h1> COUPON </h1> 
    </div>
    <div class="row mb-2">
      <div class="col-1">
          <a href="/admin/coupon/create" class="btn btn-primary"> Create</a>
      </div>
      <div class="col-3">
        <a href="/admin/coupon/donate" class="btn btn-primary">Donate Client</a>
    </div>
  </div>
    <div class="row justify-content-center">
        <div class="col-10 border border-dark rounded p-3 ">
           <div class="row">
            <aside>
              <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                <table class="table">
                  <thead class="thead-dark" style="position: sticky; top: 0; background-color: white; z-index: 1;">
                  <tr>
                  <th>STT</th>
                  <th>ID</th>
                  <th>Name</th>
                  <th>Coupon</th>
                  <th>Quantity</th>
                  <th>Active</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% for(var i=0; i < data.length ; i++){%>   
                <tr>
                  <td><%= i %></td>
                  <td><%= data[i].id %></td>
                  <td><%= data[i].name %></td>
                  <td><%= data[i].coupon %></td>
                  <td><%= data[i].quantity %></td>
                  <td><a class="nav-link text-dark" href="/admin/coupon/active/<%= data[i].id %>"><% if(data[i].action == 0){%>
                    <p>Tắt</p><%}else{%>
                      <p>Bật</p>
                    <%}%></a></td>
                <td class="d-flex"><a class="nav-link text-dark" href="/admin/coupon/edit/<%= data[i].id %>"> Chi tiết /<a class="nav-link text-dark" href="/admin/coupon/delete/<%= data[i].id %>"> Xóa</a></a></td>
                </tr>
                <%}%>
              </tbody>
            </table>
          </div>
        </aside>          
          </div> 
       </div> 
    </div>
    </div>
    </div>
  </body>
</html>