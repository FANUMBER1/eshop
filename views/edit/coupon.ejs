<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../common/admin/header.ejs') %>

    <style>
      body, html {
          height: 100%;
          margin: 0;
      }
      .container-fluid {
          height: 100%;
      }
      .row {
          height: 100%;
      }
      .position-fixed {
          height: 100vh;
      }
      .main-content {
          margin-left: 250px; /* Điều chỉnh theo chiều rộng của sidebar */
          padding: 20px;
      }
      .dropdown {
    position: relative;
    display: inline-block;
}

#dropdown-btn {
    background-color: #000000;
    color: white;
    padding: 5px 10px;
    border: none;
    cursor: pointer;
    border-radius: 4px;
    font-size: 14px;
    height: 45px;
    margin-left: -29px;
    margin-top: 5px;
    width: 140px;
}


#dropdown-btn:hover {
    background-color: #000000;
}

.dropdown-content {
    margin-top: 1px;
    display: none;
    position: absolute;
    background-color: #f9f9f9;
    min-width: 330px;
    box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
    padding: 10px;
    z-index: 9999999;
    border-radius: 4px;
    max-height: 150px;
    /* Chiều cao tối đa cho dropdown */
    overflow-y: auto;
    margin-left: -30px;
    /* Kích hoạt cuộn dọc khi chiều cao vượt quá giới hạn */
}



.dropdown-content label {
    display: block;
    margin-bottom: 5px;
}

.dropdown-content input {
    margin-right: 10px;
}

.show {
    display: block;
}

#output {
    min-height: 45px;
    height: auto;
    border: 1px solid #000000;
    /* Đường viền màu xanh dương */
    padding: 5px;
    /* Thêm khoảng cách bên trong */
    border-radius: 5px;
    /* Tạo góc bo tròn */
    margin-top: 5px;
    transition: height 0.3s ease;
    /* Thêm hiệu ứng mở rộng mượt */
    /* Tạo khoảng cách giữa label và output */
}

.option-div {
    background-color: #f1f1f1;
    border: 1px solid #ddd;
    padding: 5px 10px;
    margin: 5px;
    display: inline-block;
    border-radius: 4px;
    position: relative;
}

.remove-btn {
    color: red;
    cursor: pointer;
    margin-left: 10px;
    font-weight: bold;
}




.dropdownform {
    position: relative;
    display: inline-block;
}

#btn1 {
