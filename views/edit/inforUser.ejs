<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('../common/admin/header.ejs') %>

  <style>
    body,
    html {
      height: 100%;
      margin: 0;
    }

    .container-fluid {
      height: 100%;
    }

    .row {
      height: 100%;
    }

    .position-fixed {
      height: 100vh;
    }

    .main-content {
      margin-left: 250px;
      /* Điều chỉnh theo chiều rộng của sidebar */
      padding: 20px;
    }
    .dropdown {
    position: relative;
    display: inline-block;
}

#dropdown-btn {
    background-color: #000000;
    color: white;
    padding: 5px 10px;
    border: none;
    cursor: pointer;
    border-radius: 4px;
    font-size: 14px;
    height: 45px;
    margin-left: -25px;
    margin-top: 5px;
    width: 140px;
}


#dropdown-btn:hover {
    background-color: #000000;
}

.dropdown-content {
    margin-top: 0px;
    display: none;
    position: absolute;
    background-color: #f9f9f9;
    min-width: 330px;
    box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
    padding: 10px;
    z-index: 9999999;
    border-radius: 4px;
    max-height: 72px;
    /* Chiều cao tối đa cho dropdown */
    overflow-y: auto;
    margin-left: -331px;
    /* Kích hoạt cuộn dọc khi chiều cao vượt quá giới hạn */
}



.dropdown-content label {
    display: block;
    margin-bottom: 5px;
}

.dropdown-content input {
    margin-right: 10px;
}

.show {
    display: block;
}

#output {
    min-height: 45px;
    height: auto;
    border: 1px solid #000000;
    /* Đường viền màu xanh dương */
    padding: 5px;
    /* Thêm khoảng cách bên trong */
    border-radius: 5px;
    /* Tạo góc bo tròn */
    margin-top: 5px;
    transition: height 0.3s ease;
    /* Thêm hiệu ứng mở rộng mượt */
    /* Tạo khoảng cách giữa label và output */
}

.option-div {
    background-color: #f1f1f1;
    border: 1px solid #ddd;
    padding: 5px 10px;
    margin: 5px;
    display: inline-block;
    border-radius: 4px;
    position: relative;
}

.remove-btn {
    color: red;
    cursor: pointer;
    margin-left: 10px;
    font-weight: bold;
}
.dropdownform {
    position: relative;
    display: inline-block;
}

  </style>
</head>

<body>
  <%- include('../common/admin/siderbaadmin.ejs') %>

    <!--main-content-->
    </div>
    <div class="main-content ml-2 col-10">
      <div class="row text-center">
        <h1>EDIT USER ROLE </h1>
      </div>
      <form action="/admin/inforuser/edit/<%= data.id %>" method="post" enctype="multipart/form-data">
        <div class="row justify-content-center">
          <div class="col-8 border border-dark rounded p-3 ">
            <div class="row mb-5 overflow-hidden ">
              <div class="form-group">
                <label for="exampleInputEmail1">Tên Đăng Nhập</label>
                <input type="text" class="form-control" id="exampleInputEmail1" value="<%=data.name %>" name="name">
              </div>
              <div class="form-group">
                <label for="exampleInputEmail1">Email</label>
                <input type="text" class="form-control" id="exampleInputEmail1" value="<%=data.email %>"
                  name="email">
              </div>
              <div class="form-group">
                <label for="exampleInputPassword1">Mật Khẩu</label>
                <input type="password" class="form-control" id="exampleInputPassword1" value="<%=data.pass %>"
                  name="pass">
                <div class="form-group">
                  <lable>Logo</lable>
                  <div class="col-sm-offset-1 col-sm-5">
                    <div class="single-about-img">
                    </div>
                  </div>
                  <input type="file" name="img">
                </div>
                <div class="form-group">
                  <label for="email">Positon</label>
                  <select class="form-select" aria-label="Default select example" value="<%=data.position %>"
                    name="position">
                    <% for (var i=0 ; i < datarole.length; i++) {%>
                      <% if(data.role.position==datarole[i].position){%>
                        <option selected value="<%=datarole[i].id %>">
                          <%= datarole[i].position %>
                        </option>
                        <% } else{ %>
                          <option value="<%=datarole[i].id %>">
                            <%= datarole[i].position%>
                          </option>
                          <% }%>
                            <% }%>
                  </select>
                </div>
                <div class="form-group">
                  <label for="email">Typer User</label>
                  <div class="row mb-2">
                      <div class="col-9">
                          <div id="output"></div>
                      </div>
                      <div class="col-3 ">
                          <div class="dropdown">
                              <button type="button" onclick="toggleDropdown()" id="dropdown-btn">Select Options</button>
                              <div id="dropdown-content" class="dropdown-content">
                                  <% for(var i=0; i< typer.length; i++){%>
                                      <% var check=0; %>
                                      <% for(var j=0; j< data.typer.length;j++){%>
                                          <% if(typer[i].id == data.typer[j].typer.id){%>
                                              <% check=1; %>
                                          <%}%>
                                      <%}%>
                                      <% if(check==1){%>
                                          <label><input  type="checkbox" checked name="typer" value="<%=typer[i].id %>"><%=typer[i].name %></label>
                                      <%}else{%>													
                                          <label><input  type="checkbox" name="typer" value="<%=typer[i].id %>"><%=typer[i].name %></label>
                                  <%}%>
                              <%}%>
                              </div>
                          </div>
                      </div>
                  </div>
                </div>
                <button type="submit" class="btn btn-default btn-dark mt-2 mb-2 ">UPDATE</button>
                <button type="button" class="btn btn-dark btn-default "><a href="/admin/user"
                    class="nav-link text-white">RETURN</a></button>
              </div>
            </div>
          </div>
      </form>
    </div>

    <script src="/assets/js/js.js"></script>


</body>

</html>