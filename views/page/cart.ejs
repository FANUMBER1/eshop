<!DOCTYPE html>
<html lang="zxx">
<head>
	<%- include('../common/view/header.ejs') %>
	<%- include('../common/view/css.ejs') %>
	<style>
		a.btn {
		  color: white;
		  border-color: white;
		  border:2px; /* Màu chữ trước khi hover */
		}
	  
		a.btn:hover {
		  color: white; /* Màu chữ khi hover, có thể chỉnh thành màu khác nếu muốn */
		}
		a.btn.active {
         background-color:#fd7e14;
         color: white; /* Màu chữ khi được chọn */
}
	  </style>
	  <script>
        // Kiểm tra nếu có thông báo lỗi và hiển thị alert
        <%if (errorMessage != undefined) { %>
            alert('<%= errorMessage %>');
        <% } %>
    </script>
</head>
<body class="js">
	
	<!-- Preloader -->
	
	<!-- End Preloader -->
		
		<!-- Header -->
		<%-include('../common/view/siderbar.ejs')%>
		<!--/ End Header -->
	
	<!-- Breadcrumbs -->
	<div class="breadcrumbs">
		<div class="container">
			<div class="row">
				<div class="col-12">
					<div class="bread-inner">
						<ul class="bread-list">
							<li><a href="/">Home<i class="ti-arrow-right"></i></a></li>
							<li class="active"><a href="/cart">Cart</a></li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- End Breadcrumbs -->
   		
	<!-- Shopping Cart -->
	<% if(carts != undefined && carts.length > 0 ){%>
	<form action="/checkout" method="post">
	<div class="shopping-cart section">
		<div class="container">
			<div class="row">
				<div class="col-12">
					<!-- Shopping Summery -->
					<table class="table shopping-summery">
						<thead>
							<tr class="main-hading">
								<th>OPTIONS</th>
								<th>PRODUCT</th>
								<th>NAME</th>
								<th class="text-center">UNIT PRICE</th>
								<th class="text-center">QUANTITY</th>
								<th class="text-center">TOTAL</th> 
								<th class="text-center"><i class="ti-trash remove-icon"></i></th>
							</tr>
						</thead>
						<tbody>
							<% if(carts != undefined ){%>
								<% for(var i=0; i< carts.length ; i++){%>
									<tr id="<%= carts[i].product.id %>">
										<td> 
											<input name="products" id="<%= carts[i].product.id %>" type="checkbox" value="<%= carts[i].product.id %>" onchange="updateCheckedRows()">
										</td>
										<td class="image" data-title="No"><img src="<%= carts[i].product.img[0] %>" alt="#"></td>
										<td class="product-des" data-title="Description">
											<p class="product-name"><a href="#"><%= carts[i].product.name %></a></p>
											<p class="product-des"><%= carts[i].product.userclass.name %>
												<%if(parseInt(carts[i].product.discount.name)!=0){%>
													/Giảm giá <%= carts[i].product.discount.name %>%
													<%}%>
											</p>
										</td>
										<td class="price" data-title="Price">$
											<%if(parseInt(carts[i].product.discount.name)!=0){%>
										<span>
											<%=carts[i].product.price- parseInt(carts[i].product.discount.name)*carts[i].product.price/100 %></span>  / $ <s><%=carts[i].product.price%> </s>
											<%}else{%>
												<span><%=carts[i].product.price%></span>
												<%}%>
										</td>
										<td class="qty" data-title="Qty">
											<div class="input-group">
												<div class="button minus">
													<button type="button" class="btn btn-primary btn-number" data-type="minus" id="<%= carts[i].product.id %>" data-field="quant<%= carts[i].product.id %>" onclick="changes(this)">
														<i class="ti-minus"></i>
													</button>
												</div>
												<input type="text" name="quant<%= carts[i].product.id %>"  id="<%= carts[i].product.id %>"  class="input-number"   data-min="1" data-max="100" value="<%= carts[i].quantity%>">
												<div class="button plus">
													<button type="button" class="btn btn-primary btn-number" data-type="plus" data-field="quant<%= carts[i].product.id %>" id="<%= carts[i].product.id %>"  onclick="changes(this)">
														<i class="ti-plus"></i>
													</button>
												</div>
											</div>
										</td>
										<td class="total-amount" data-title="Total">$<span><%= parseInt(carts[i].quantity)*(carts[i].product.price- parseInt(carts[i].product.discount.name)*carts[i].product.price/100) %></span></td>
										<td class="action" data-title="Remove"><a href="/cart/delete/<%= carts[i].product.id %>"><i class="ti-trash remove-icon"></i></a></td>
									</tr>
							    <%}%>
							<%}%>
						</tbody>
					</table>
					<!--/ End Shopping Summery -->
				</div>
			</div>
			
			
			<div class="row">
				<div class="col-12">
					<!-- Total Amount -->
					<div class="total-amount">
						<div class="row">
							<div class="col-lg-7 col-md-5 col-12">
								<div class="left">
									
								</div>
							</div>
							<div class="col-lg-5 col-md-7 col-12">
								<div class="right">
									<ul>
										<% if(carts.length > 0 ){%>
										<li class="last">You Pay <span class="total-oder1">$0.00</span></li>
										
									</ul>
									<%}%>
									<div class="button5">
										<button class="btn" type="submit">CHECKOUT</button>
										<a href="/product" class="btn">Continue shopping</a>
									</div>
								</div>
							</div>
						</div>
					</div>
					<!--/ End Total Amount -->
				</div>
			</div>
		</div>
	</div>
</form>
<%}else{%>
	<div class="product-area most-popular related-product section">
		<div class="product-area most-popular section">
			<div class="container">
				<div class="row d-flex justify-content-center mx-auto">
						<div class="col-5">
						<img src="/assets/images/no-products.png">
						</div>
				</div>
				<div class="row  justify-content-center ">
						<a href="/product" class="btn">Continue shopping</a>
			</div>
			</div>
		</div>
	</div>					
 <%}%>
	<!--/ End Shopping Cart -->
			
	<!-- Start Shop Services Area  -->
	<section class="shop-services section">
		<div class="container">
			<div class="row">
				<div class="col-lg-3 col-md-6 col-12">
					<!-- Start Single Service -->
					<div class="single-service">
						<i class="ti-rocket"></i>
						<h4>Free shiping</h4>
						<p>Orders over $100</p>
					</div>
					<!-- End Single Service -->
				</div>
				<div class="col-lg-3 col-md-6 col-12">
					<!-- Start Single Service -->
					<div class="single-service">
						<i class="ti-reload"></i>
						<h4>Free Return</h4>
						<p>Within 30 days returns</p>
					</div>
					<!-- End Single Service -->
				</div>
				<div class="col-lg-3 col-md-6 col-12">
					<!-- Start Single Service -->
					<div class="single-service">
						<i class="ti-lock"></i>
						<h4>Sucure Payment</h4>
						<p>100% secure payment</p>
					</div>
					<!-- End Single Service -->
				</div>
				<div class="col-lg-3 col-md-6 col-12">
					<!-- Start Single Service -->
					<div class="single-service">
						<i class="ti-tag"></i>
						<h4>Best Peice</h4>
						<p>Guaranteed price</p>
					</div>
					<!-- End Single Service -->
				</div>
			</div>
		</div>
	</section>
	<!-- End Shop Newsletter -->
	
	<!-- Start Shop Newsletter  -->
	<section class="shop-newsletter section">
		<div class="container">
			<div class="inner-top">
				<div class="row">
					<div class="col-lg-8 offset-lg-2 col-12">
						<!-- Start Newsletter Inner -->
						<div class="inner">
							<h4>Newsletter</h4>
							<p> Subscribe to our newsletter and get <span>10%</span> off your first purchase</p>
							<form action="mail/mail.php" method="get" target="_blank" class="newsletter-inner">
								<input name="EMAIL" placeholder="Your email address" required="" type="email">
								<button class="btn">Subscribe</button>
							</form>
						</div>
						<!-- End Newsletter Inner -->
					</div>
				</div>
			</div>
		</div>
	</section>
	<!-- End Shop Newsletter -->
	
	
	
	<!-- Modal -->
        
        <!-- Modal end -->
	
	<!-- Start Footer Area -->
	<%- include('../common/view/footer.ejs') %>

	<!-- /End Footer Area -->
	
	<%- include('../common/view/js.ejs') %>
	<!-- <script src="/assets/js/carts.js"></script> -->
	<script>
	
	function changes(button) {
    const productId = button.id
	const row = document.getElementById(productId);
    const input =row.querySelector('.input-number'); // Lấy ô input tương ứng
	const p = button.getAttribute('data-type');
	var quantity=0
    
	if(p == 'plus'){
		console.log(1)
	quantity = parseInt(input.value) +1 || 0;
	row.querySelector('.input-number').value = quantity;

	}else{
		if(parseInt(input.value) > 1){
			quantity = parseInt(input.value)-1 || 0; // Kiểm tra nếu nhập không phải số thì mặc định là 0
		}else{
			quantity=1
		}
		row.querySelector('.input-number').value = quantity;

	}
	console.log(parseInt(row.querySelector('.input-number').value))
	const quantityLast = parseInt(row.querySelector('.input-number').value); // Lấy ô input tương ứng
    console.log(quantityLast)
	console.log(parseInt(row.querySelector('.input-number').value))
    const price = parseFloat(row.querySelector('.price span').textContent);
    const totalAmount = (quantityLast) * price;
    row.querySelector('.total-amount span').textContent = totalAmount;
	updateCheckedRows()
}

function updateCheckedRows() {
     // Lấy tất cả các thẻ <tr>
		const rows = document.querySelectorAll('tr');
    const checkedRows = [];

    var total=0;
    rows.forEach(row => {
        // Tìm checkbox trong <tr>
        const checkbox = row.querySelector('input[type="checkbox"]');
        if (checkbox && checkbox.checked) {
            const productId = row.id; 
            const productName = row.querySelector('.product-name a').textContent; 
            const price = parseFloat(row.querySelector('.price span').textContent); 
            const quantityInput = row.querySelector('.input-number'); 
            const quantity = parseInt(quantityInput.value) || 1; 
            total=total+price*(quantity)           
        }
    });
		 document.querySelector('.total-oder1').textContent= '$'+total.toFixed(2)

    // Nếu không có <tr> nào được chọn
    if (checkedRows.length === 0) {
        console.log('No products selected.');
    }
}
	</script>
	
</body>
</html>