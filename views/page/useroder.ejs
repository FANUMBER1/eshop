<!DOCTYPE html>
<html lang="zxx">
<head>
	<%- include('../common/view/header.ejs') %>
	<%- include('../common/view/css.ejs') %>
<style>
	.table-wrapper {
    max-height: 400px; /* Chiều cao cố định của vùng chứa bảng */
    overflow-y: auto; /* Thanh cuộn dọc cho tbody */
    position: relative;
}

table {
    width: 100%;
    border-collapse: collapse; /* Đảm bảo không có khoảng cách giữa các ô */
}

thead {
    position: sticky; /* Giữ cố định phần đầu bảng */
    top: 0; /* Đặt nó ở vị trí trên cùng */
    background-color: #fff; /* Màu nền của phần đầu để nhìn rõ */
    z-index: 1; /* Đảm bảo phần thead nằm trên tbody */
}

th, td {
    padding: 10px;
    text-align: center;
    border-bottom: 1px solid #ddd; /* Đường viền giữa các ô */
}

tbody tr:nth-child(even) {
    background-color: #f9f9f9; /* Màu nền xen kẽ cho các hàng trong tbody */
}
		a.nav-link {
		  color: rgb(0, 0, 0); /* Màu chữ trước khi hover */
		}
	  
		a.nav-link:hover {
		  color: #F7941D; /* Màu chữ khi hover, có thể chỉnh thành màu khác nếu muốn */
		}
</style>
</head>
<body class="js">
	
	
	<!-- End Preloader -->
		
		<!-- Header -->
		<%-include('../common/view/siderbar.ejs')%>
		<!--/ End Header -->
	
	<!-- Breadcrumbs -->
	<div class="breadcrumbs">
		<div class="container">
			<div class="row">
				<div class="col-12">
					<div class="bread-inner">
						<ul class="bread-list">
							<li><a href="/">Home<i class="ti-arrow-right"></i></a></li>
							<li class="active"><a href="/oder">Oder</a></li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- End Breadcrumbs -->
			
	<!-- Shopping Cart -->
	<section class="blog-single section">
		<div class="container">
			<div class="row">
				<div class="col-lg-2 col-2">
					<div class="content">
					<a class="nav-link" href="/my-account">My account</a>
					<a class="nav-link" href="/oder">Lich su don hang</a>							
					<a class="nav-link" href="/my-account/address">Dia chi giao hang</a>
					<a class="nav-link" href="/my-account/coupon">Ma giam gia</a>

					  </div>
				</div>
				<div class="col-10">
					<div class="shopping-cart section">
						<div class="container">
							<div class="row">
								<div class="col-12">
									<!-- Shopping Summery -->
									<div class="table-wrapper">
										<table class="table shopping-summery">
											<thead>
												<tr class="main-hading">
													<th>PRODUCT</th>
													<th>ADDRESS</th>
													<th class="text-center">UNIT PRICE</th>
													<th class="text-center">QUANTITY</th>
													<th class="text-center">TOTAL</th>
												</tr>
											</thead>
											<tbody>
												<% if(data != undefined ){%>
													<% for(var i=0; i< data.length ; i++){%>
												<tr>
													<td  data-title="No"><img src="<%= data[i].product.img[0] %>" alt="#">
														<p class=""><a href="#"><%= data[i].product.name %></a></p>
													</td>
													<td class="product-des" data-title="Description">
														<p class="product-des"><%= data[i].oder.address.address %></p>
														<p class="product-des"><%= data[i].oder.address.name %>|<%= data[i].oder.address.phone %></p>
													</td>
													<td class="price" data-title="Price"><span>$<%= data[i].product.price %>.00 </span></td>
													<td class="price" data-title="Price"><span><%= data[i].quantity %> </span></td>
													<td class="total-amount" data-title="Total"><span>$<%= parseInt(data[i].quantity) * parseInt(data[i].product.price) %>.00</span></td>
												</tr>
													<%}%>
												<%}%>
											</tbody>
										</table>
									</div>
									<!--/ End Shopping Summery -->
								</div>
							</div>
						</div>
					</div>
					
				</div>
			</div>
		</div>
	</section>

			
	<!-- Start Footer Area -->
	<%- include('../common/view/footer.ejs') %>

	<!-- /End Footer Area -->
	
	<%- include('../common/view/js.ejs') %>

</body>
</html>