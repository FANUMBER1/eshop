<!DOCTYPE html>
<html lang="zxx">
<head>
	<%- include('../common/view/header.ejs') %>
	<%- include('../common/view/css.ejs') %>
	<style>
		a.nav-link {
		  color: rgb(0, 0, 0); /* Màu chữ trước khi hover */
		}
	  
		a.nav-link:hover {
		  color: #F7941D; /* Màu chữ khi hover, có thể chỉnh thành màu khác nếu muốn */
		}
	  </style>
</head>
<body class="js">
	
	<!-- Preloader -->
	
	<!-- End Preloader -->
		
		<!-- Header -->
		<%-include('../common/view/siderbar.ejs')%>
		<!--/ End Header -->
		
		<!-- Breadcrumbs -->
		<div class="breadcrumbs">
			<div class="container">
				<div class="row">
					<div class="col-12">
						<div class="bread-inner">
							<ul class="bread-list">
								<li><a href="/">Home<i class="ti-arrow-right"></i></a></li>
								<li class="active"><a href="/my-account">My account</a></li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- End Breadcrumbs -->
		
		<section class="blog-single section">
			<div class="container">
				<div class="row">
					<div class="col-lg-2 col-2">
						<div class="content">
						<a class="nav-link"  href="/my-account">Thong tin đat don</a>
						<a class="nav-link"  href="/oder">Lich su don hang</a>							
						<a class="nav-link"  href="/my-account/address">Dia chi giao hang</a>
						<a class="nav-link" href="/my-account/coupon">Ma giam gia</a>

						  </div>
					</div>
					<div class="col-lg-10 col-10">
						<section class="shop checkout section" style="margin-top: -40px;">
						<div class="checkout-form">
						<form class="form" method="post" action="/my-account" >
							<div class="row">
								<div class="col-lg-6 col-md-6 col-12">
									<div class="form-group">
										<label>Name<span>*</span></label>
										<input type="text" name="name" placeholder="" value="<%= users.name %>" required="required">
									</div>
								</div>
								<div class="col-lg-6 col-md-6 col-12">
									<div class="form-group">
											<!-- <label style="color:red">Email Address Registered<span>*</span></label> -->
												<label>Email Address<span>*</span></label>
										<input type="email" name="email" placeholder="" value="<%= users.email %>"  required="required">
									</div>
								</div>
								<div class="col-lg-6 col-md-6 col-12">
									<div class="form-group">
										<label>Phone Number<span>*</span></label>
										<input type="number" name="phone" placeholder="" value="<%= users.phone %>"  required="required">
									</div>
								</div>
								<div class="col-lg-6 col-md-6 col-12">
										<div class="form-group">
											<label>Delivery address<span>*</span></label>
											<input type="text" name="address1" value="<%= users.address1 %>"  placeholder="" >
										</div>
									</div>
									
									<div class="col-lg-6 col-md-6 col-12">
										<label><span></span></label>
										<div class="form-group">
											<button class="btn" type="submit">Lưu thay đổi</button>
										</div>
									</div>
							</div>
						</form>
						</div>
						</section>
					</div>
				</div>
			</div>
		</section>
			
		<!-- Start Footer Area -->
		<%- include('../common/view/footer.ejs') %>

	<!-- /End Footer Area -->
	<%- include('../common/view/js.ejs') %>

</body>
</html>