<!DOCTYPE html>
<html lang="zxx">
<head>
	<%- include('../common/view/header.ejs') %>
	<%- include('../common/view/css.ejs') %>
	<style>
		a.btn {
		  color: white;
		  border-color: white;
		  border:2px; /* Màu chữ trước khi hover */
		}
	  
		a.btn:hover {
		  color: white; /* Màu chữ khi hover, có thể chỉnh thành màu khác nếu muốn */
		}
		a.btn.active {
         background-color:#fd7e14;
         color: white; /* Màu chữ khi được chọn */
}
	  </style>
	  </head>
<body class="js">
	
		<!-- Header -->
		<%-include('../common/view/siderbar.ejs')%>
		<!--/ End Header -->
	<!-- Breadcrumbs -->
	<div class="breadcrumbs">
		<div class="container">
			<div class="row">
				<div class="col-12">
					<div class="bread-inner">
						<ul class="bread-list">
							<li><a href="/">Home<i class="ti-arrow-right"></i></a></li>
							<li class="active"><a href="/product/like">Product Like</a></li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- End Breadcrumbs -->
  
	<!-- Start Contact -->
	
	<%if(data.length > 0){%>
		<section class="shop-home-list section">
		<div class="container">
			<div class="row">
				<div class="col-12">
					<div class="section-title">
						<h2>Product Like</h2>
					</div>
				</div>
			</div>
			<div class="row d-flex justify-content-center mx-auto">
                <% for(var i=0; i< data.length; i++){%>
				<div class="col-lg-5 col-md-6 col-12">
					<!-- Start Single List  -->
					<div class="single-list">
						<div class="row ">
							<div class="col-lg-6 col-md-6 col-6">
								<div class="list-image overlay">
									<img src="<%= data[i].product.img[0] %>" style="width:154px ; height:187px" alt="#">
									<a href="/product/<%=data[i].product.id %>" class="buy"><i class="fa fa-shopping-bag"></i></a>
								</div>
							</div>
							<div class="col-lg-5 col-md-5 col-5 no-padding">
								<div class="content">
									<h4 class="title"><a href="#"><%=data[i].product.name %></a></h4>
									<p class="price with-discount">$<%=data[i].product.price %></p>
								</div>
							</div>
							<div class="col-lg-1 col-md-1 col-1 no-padding  ">
								<a href="/product/like/delete/<%= data[i].product.id %>"><i class="ti-trash remove-icon"></i></a>
							</div>
						</div>
					</div>
                </div>
                <%}%>
			</div>
		</div>
	</section>
	<%}else{%>
		<div class="product-area most-popular related-product section">
			<div class="product-area most-popular section">
				<div class="container">
					<div class="row d-flex justify-content-center mx-auto">
							<div class="col-5">
							<img src="/assets/images/no-products.png">
							</div>
					</div>
					<div class="row  justify-content-center ">
							<a href="/product" class="btn">Continue shopping</a>
				</div>
				</div>
			</div>
		</div>					
	 <%}%>	
	<!-- Start Footer Area -->
	<%- include('../common/view/footer.ejs') %>

	<!-- /End Footer Area -->
	
	<%- include('../common/view/js.ejs') %>

</body>
</html>