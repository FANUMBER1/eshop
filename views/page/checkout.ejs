<!DOCTYPE html>
<html lang="zxx">

<head>
	<%- include('../common/view/header.ejs') %>
		<%- include('../common/view/css.ejs') %>
			<style>
				a.nav-link {
					color: rgb(0, 0, 0);
					/* Màu chữ trước khi hover */
				}

				a.nav-link:hover {
					color: #F7941D;
					/* Màu chữ khi hover, có thể chỉnh thành màu khác nếu muốn */
				}

				.table-wrapper {
					max-height: 150px;
					/* Chiều cao cố định của vùng chứa bảng */
					overflow-y: auto;
					/* Thanh cuộn dọc cho tbody */
					position: relative;
				}

				table {
					width: 100%;
					border-collapse: collapse;
					/* Đảm bảo không có khoảng cách giữa các ô */
				}

				thead {
					position: sticky;
					/* Giữ cố định phần đầu bảng */
					top: 0;
					/* Đặt nó ở vị trí trên cùng */
					background-color: #fff;
					/* Màu nền của phần đầu để nhìn rõ */
					z-index: 1;
					/* Đảm bảo phần thead nằm trên tbody */
				}

				th,
				td {
					padding: 10px;
					border-bottom: 1px solid #ddd;
					/* Đường viền giữa các ô */
				}

				tbody tr:nth-child(even) {
					background-color: #f9f9f9;
					/* Màu nền xen kẽ cho các hàng trong tbody */
				}

				a.nav-link {
					color: rgb(0, 0, 0);
					/* Màu chữ trước khi hover */
				}

				a.nav-link:hover {
					color: #F7941D;
					/* Màu chữ khi hover, có thể chỉnh thành màu khác nếu muốn */
				}

				#hiddenForm1 {
					display: block;
					position: relative;
					width: fit-content;
					max-height: 200px;
					overflow-y: scroll;
					top: -58px;
                    left: 140px;
					transform: translate(-50%, -50%);
					z-index: 9999;
					background-color: white;
					padding: 20px;
					box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
				}
				
			</style>

</head>

<body class="js">



	<!-- Header -->
	<%-include('../common/view/siderbar.ejs')%>
		<!--/ End Header -->

		<!-- Breadcrumbs -->
		<div class="breadcrumbs">
			<div class="container">
				<div class="row">
					<div class="col-12">
						<div class="bread-inner">
							<ul class="bread-list">
								<li><a href="/">Home<i class="ti-arrow-right"></i></a></li>
								<li class="active"><a href="/checkout">Checkout</a></li>
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- End Breadcrumbs -->
		<form action="/oder/<%=idoder[0].id %>" method="get">
			<% if(datas !=undefined){%>
				<div class="shopping-cart section" style="margin-bottom: -70px ; margin-top: -24px;">
					<div class="container">
						<div class="row">
							<div class="col-12">
								<div class="table-wrapper">
									<table class="table shopping-summery">
										<tbody>
											<% for(var i=0; i< datas.length ; i++){%>
												<% if( datas[i].active==1){%>
													<tr>
														<td>
															<label>
																<input type="radio" name="select"
																	value="<%= datas[i].id %>" checked>
															</label>
														</td>
														<td class="product-des" data-title="Description">
															<p class="product-name"><a href="#">
																	<%= datas[i].name %> | <%= datas[i].phone %>
																</a></p>
															<p class="product-des">
																<%= datas[i].address %>
															</p>
														</td>
														<td>
															<% if( datas[i].active==1){%>
																<p class="product-name"><a href="#">Mặc định </a></p>
																<%}%>
														</td>
													</tr>
													<%}%>
														<%}%>
															<% for(var i=0; i< datas.length ; i++){%>
																<% if( datas[i].active==0){%>
																	<tr>
																		<td>
																			<label>
																				<input type="radio" name="select"
																					value="<%= datas[i].id %>">
																			</label>
																		</td>

																		<td class="product-des"
																			data-title="Description">
																			<p class="product-name"><a href="#">
																					<%= datas[i].name %> | <%=
																							datas[i].phone %>
																				</a></p>
																			<p class="product-des">
																				<%= datas[i].address %>
																			</p>
																		</td>
																		<td>
																		</td>
																	</tr>
																	<%}%>
																		<%}%>

										</tbody>
									</table>
								</div>
							</div>
						</div>
					</div>
				</div>
				<%}%>
					<!-- Start Checkout -->
					<div class="shopping-cart section">
						<div class="container">
							<div class="row">
								<div class="col-12">
									<!-- Shopping Summery -->
									<table class="table shopping-summery">
										<thead>
											<tr class="main-hading">
												<th>PRODUCT</th>
												<th>NAME</th>
												<th class="text-center">UNIT PRICE</th>
												<th class="text-center">QUANTITY</th>
												<th class="text-center">TOTAL</th>
											</tr>
										</thead>
										<tbody>
											<% if(data !=undefined ){%>
												<% for(var i=0; i< data.length ; i++){%>
													<tr>
														<td class="image" data-title="No"><img
																src="<%= data[i].product.img[0]%>" alt="#"></td>
														<td class="product-des" data-title="Description">
															<p class="product-name"><a href="#">
																	<%= data[i].product.name%>
																</a></p>
															<p class="product-des">
																<%=data[i].product.classfy.name%> <%= data[i].size%>,<%= data[i].color%>
															</p>
														</td>
														<td class="price" data-title="Price">$
															<%if(parseInt(data[i].product.discount.name)!=0){%>
																<span>
																	<%=data[i].product.price-
																		parseInt(data[i].product.discount.name)*data[i].product.price/100
																		%></span> / $ <s>
																	<%=data[i].product.price%>
																</s>
																<%}else{%>
																	<span>
																		<%=data[i].product.price%>
																	</span>
																	<%}%>
														</td>
														<td class="price" data-title="Price"><span>
																<%= data[i].quantity%>
															</span></td>
														<td class="total-amount" data-title="Total"><span>$<%=
															(parseInt(data[i].quantity)*parseInt(data[i].product.price)
																			-parseInt(data[i].quantity)*(parseInt(data[i].product.price)*parseInt(data[i].product.discount.name)/100)
																			)%>
															</span></td>
													</tr>
													<%}%>
										</tbody>
									</table>
									<!--/ End Shopping Summery -->
								</div>
							</div>
							<div class="row">
								<div class="col-12">
									<!-- Total Amount -->
									<div class="total-amount">
										<div class="row">
											<div class="col-lg-6 col-md-5 col-12">
												<div class="left">
													<a class="btn btn-primary" id="showFormBtn1" style="color:white">Add
														Coupon</a>

												</div>
											</div>
											<div class="col-lg-6 col-md-7 col-12">
												<div class="right">
													<ul>
														<li>Cart Subtotal<span>$
																
																				<%=sum %>
																<%}%>
															</span></li>
															<% if(parseInt(save) > 0){%>
																<li>Coupon<span><%=couponoder[0].coupon.name %></span></li>
														<li>You Save<span>
																 <%= save%>
														</span></li>
														<%}%>
														<li class="last">You Pay<span>$
															<%if(sum <=save ){%>
																<%= 0%>
																<%}else{%>
																	<%=sum - save%>
																	<%}%>.00</span></li>
													</ul>
													<div class="button5">
														<div class="content">
															<button type="submit" class="btn">proceed to
																checkout</button>
														</div>
													</div>
		                              </form>
		</div>
		</div>
		</div>
		</div>
		<!--/ End Total Amount -->
		</div>
		<div class="checkout-form" id="hiddenForm1" style="display: none;">
			<form class="form" method="post" action="/checkout/coupon/<%=idoder[0].id %>">
				<table>
					<tbody>
						<%for(var i=0; i< coupon.length;i++){%>
							<tr>
								<td style="padding:10px">
									<%if(save > 0 && coupon[i].id == couponoder[0].couponid){%>
									<input type="radio" name="coupon" value="<%= coupon[i].id %>" checked>
									<%}else{%>
										<input type="radio" name="coupon" value="<%= coupon[i].id %>">
										<%}%>
									
								</td>
								<td style="padding:10px">
									<%= coupon[i].name %>
								</td>
							</tr>
							<%}%>
					</tbody>
				</table>
				<button style="position: sticky; z-index: 1;" type="submit" class="btn">Access</button>
			</form>
		</div>
		</div>
		</div>
		</div>

		<!--/ End Checkout -->

		<!-- Start Shop Services Area  -->
		<section class="shop-services section home">
			<div class="container">
				<div class="row">
					<div class="col-lg-3 col-md-6 col-12">
						<!-- Start Single Service -->
						<div class="single-service">
							<i class="ti-rocket"></i>
							<h4>Free shiping</h4>
							<p>Orders over $100</p>
						</div>
						<!-- End Single Service -->
					</div>
					<div class="col-lg-3 col-md-6 col-12">
						<!-- Start Single Service -->
						<div class="single-service">
							<i class="ti-reload"></i>
							<h4>Free Return</h4>
							<p>Within 30 days returns</p>
						</div>
						<!-- End Single Service -->
					</div>
					<div class="col-lg-3 col-md-6 col-12">
						<!-- Start Single Service -->
						<div class="single-service">
							<i class="ti-lock"></i>
							<h4>Sucure Payment</h4>
							<p>100% secure payment</p>
						</div>
						<!-- End Single Service -->
					</div>
					<div class="col-lg-3 col-md-6 col-12">
						<!-- Start Single Service -->
						<div class="single-service">
							<i class="ti-tag"></i>
							<h4>Best Peice</h4>
							<p>Guaranteed price</p>
						</div>
						<!-- End Single Service -->
					</div>
				</div>
			</div>
		</section>
		<!-- End Shop Services -->

		<!-- Start Shop Newsletter  -->
		<section class="shop-newsletter section">
			<div class="container">
				<div class="inner-top">
					<div class="row">
						<div class="col-lg-8 offset-lg-2 col-12">
							<!-- Start Newsletter Inner -->
							<div class="inner">
								<h4>Newsletter</h4>
								<p> Subscribe to our newsletter and get <span>10%</span> off your first purchase</p>
								<form action="/assets/mail/mail.php" method="get" target="_blank"
									class="newsletter-inner">
									<input name="EMAIL" placeholder="Your email address" required="" type="email">
									<button class="btn">Subscribe</button>
								</form>
							</div>
							<!-- End Newsletter Inner -->
						</div>
					</div>
				</div>
			</div>
		</section>
		<!-- End Shop Newsletter -->

		<!-- Start Footer Area -->
		<!-- Footer Top -->
		<div class="footer-top section">
			<div class="container">
				<div class="row">
					<div class="col-lg-5 col-md-6 col-12">
						<!-- Single Widget -->
						<div class="single-footer about">
							<div class="logo">
