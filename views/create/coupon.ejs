<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../common/admin/header.ejs') %>

        
</head>

<body>
    <%- include('../common/admin/siderbaadmin.ejs') %>
      <%- include('../common/admin/coupon.ejs') %>
        <!--main-content-->
        </div>
        <div class="main-content col-10">
            <div class="row text-center">
                <h1>CREATE COUPON</h1>
            </div>
            <form action="/admin/coupon/create" method="post">
                <div class="row justify-content-center">
                    <div class="col-10 border border-dark rounded p-3 ">
                        <div class="row mb-5 overflow-hidden ">
                            <div class="col-lg-6 col-md-6 col-12">
                                <div class="form-group">
                                    <label>Name</label>
                                    <input type="text" class="form-control" id="email" name="name">
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6 col-12">
                                <div class="row ">
                                    <div class="col-6 mt-4 pe-0">
                                        <div class="input-group">
                                            <label class="input-group-text" for="inputGroupSelect02">Discount</label>
                                            <select class="form-select" id="inputGroupSelect02" name="discount">
                                              <option value="1" selected >Price</option>
                                              <option value="2">Percent</option>
                                            </select>
                                          </div>
                                    </div>
                                    <div class="col-6 mt-4 ps-0">
                                        <input type="text" class="form-control" id="email" name="valuediscount">
                                    </div>
                                </div>                                
                            </div>
                            <div class="col-lg-6 col-md-6 col-12">
                                <div class="form-group">
                                    <label>Quantity</label>
                                    <input type="text" class="form-control" id="email" name="quantity">
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6 col-12">
                                <div class="form-group">
                                    <label>Count Buy Min</label>
                                    <input type="text" class="form-control" id="email" name="buymin">
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6 col-12">
                                <div class="form-group">
                                    <label>Discout Min Value</label>
                                    <input type="text" class="form-control" id="email" name="discountmin">
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6 col-12">
                                <div class="form-group">
                                    <label>QuantiyMin User</label>
                                    <input type="text" class="form-control" id="email" name="usermin">
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6 col-12">
                                <label>Add Product<span>*</span></label>
                                <div class="row mb-2">
                                    <div class="col-5 pe-0">
                                        <div class="row">
                                            <div class="col-7">
                                                <div class="input-group">
                                                    <select class="form-select" id="inputGroupSelect01" name="" onchange="toggleButtons()">
                                                      <option selected value="0" >All</option>
                                                      <option  value="1">Product</option>
                                                      <option value="2">Classfy</option>
                                                    </select>
                                                </div>
                                        </div>
                                            <div class="col-5">
                                                <div class="dropdownform">
                                                    <button type="button" onclick="toggleDropdowncolor()" style="display:none;" id="btn1">Select</button>
                                                    <div id="dropdown_content" class="content1">
                                                        <% for(var i=0; i< product.length; i++){%>
                                                            <label><input type="checkbox" name="product"
                                                                    value="<%=product[i].id %>">
                                                                <%= product[i].name %>
                                                            </label>
                                                            <%}%>
                                                    </div>
                                                </div>
                                                <div class="dropdown">
                                                    <button type="button" onclick="toggleDropdown()" style="display:none;"  id="dropdownbtn">Select</button>
                                                    <div id="dropdown-content" class="dropdown-content">
                                                        <% for(var i=0; i< tag.length; i++){%>
                                                            <label><input type="checkbox" name="classfys"
                                                                    value="<%=tag[i].id %>">
                                                                <%=tag[i].name %>
                                                            </label>
                                                            <%}%>
                                                    </div>
                                                </div>
                                                <button type="button"  id="btnall" style="display:inline-block;">All</button>
                                            </div>
                                        </div>
                                        
                                    </div>
                                    <div class="col-7 ps-0">
                                        <div id="output"></div>
                                    </div>
                                    
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6 col-12">
                                <label>Donate User<span>*</span></label>
                                <section class="shop checkout section" style="margin-top: -40px;">
                                    <button type="button" class="btn btn-default btn-dark mt-5 mb-2 " id="showFormBtn">Add donate user</button>
                                <div class="checkout-form">
                                
                                </div>
                                </section>
                            </div> 
                            <button type="submit" class="btn btn-default btn-dark mt-2 mb-2 ">CREATE COUPON</button>
                            <button type="button" class="btn btn-dark btn-default "><a href="/admin/coupon"
                                    class="nav-link text-white">RETURN</a></button>
                        </div>
                    </div>
                </div>
            <div class="form" method="post" action="" id="hiddenForm" style="display: none;">
                    <div class="row">
                        <div class="col-12">
                            <h5>ALL USER</h5>
                            <label><input type="checkbox" name="typer"
                                value="All" >
                            ALL USER
                        </label>
                        </div>
                        <div class="col-12">
                            <h5>USER</h5>
                                        <% for(var i=0; i< user.length; i++){%>
                                                    <label><input type="checkbox" name="user"
                                                            value="<%=user[i].id %>" >
                                                        <%= user[i].name %>
                                                    </label>
                                            <%}%>
                        </div>
                        <div class="col-12">
                            <h5>GROUP USER</h5>
                                        <% for(var i=0; i< typer.length; i++){%>
                                                    <label><input type="checkbox" name="typer"
                                                            value="<%=typer[i].id %>" >
                                                        <%= typer[i].name %>
                                                    </label>
                                            <%}%>
                        </div>
                        </div>
    
            </div>
        </form>

        </div>
        
        <script>
			document.getElementById('showFormBtn').addEventListener('click', function() {
             var form = document.getElementById('hiddenForm');
            if (form.style.display === 'none' || form.style.display === '') {
                  form.style.display = 'block'; // Mở form
                  } else {
                       form.style.display = 'none'; // Đóng form
                        }
                           });
  		  </script>
        <script src="/assets/js/js.js"></script>

</body>

</html>