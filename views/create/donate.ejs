<div class="row justify-content-center">
    <div class="col-10 border border-dark rounded p-3 ">
       <div class="row mb-5 overflow-hidden ">
           <div class="col-lg-6 col-md-6 col-12">
         <div class="form-group">
            <label>Name</label>
            <input type="text" class="form-control" id="email"  name="name" value="<%= data.name %> ">
         </div>
           </div>
           <div class="col-lg-6 col-md-6 col-12">
         <div class="form-group">
           <label>Discount Percent</label>
           <input type="text" class="form-control" id="email"  name="discount" value="<%= data.discountpercent %> ">
        </div> 
           </div>
           <div class="col-lg-6 col-md-6 col-12">
               <div class="form-group">
                 <label>Discount Price</label>
                 <input type="text" class="form-control" id="email"  name="discount" value="<%= data.discountprice %> ">
              </div> 
                 </div>
           <div class="col-lg-6 col-md-6 col-12">
         <div class="form-group">
           <label>Quantity</label>
           <input type="text" class="form-control" id="email"  name="quantity" value="<%= data.quantity %> ">
         </div>
           </div>
           <div class="col-lg-6 col-md-6 col-12">
               <div class="form-group">
                 <label>Count Buy Min</label>
                 <input type="text" class="form-control" id="email"  name="buymin" value="<%= data.buymin %> ">
               </div>
                 </div>
                 
                     
         <div class="col-lg-6 col-md-6 col-12">
           <label>Classfy<span>*</span></label>
           <div class="row mb-2">
               <div class="col-9">
                   <div id="output"></div>
               </div>
               <div class="col-3 ">
                   <div class="dropdown">
                       <button type="button" onclick="toggleDropdown()" id="dropdown-btn">Select Options</button>
                       <div id="dropdown-content" class="dropdown-content">
                           <% for(var i=0; i< tag.length; i++){%>
                               <% var check=0; %>
                               <% for(var j=0; j< data.classfy.length;j++){%>
                                   <% if(tag[i].id == data.classfy[j].classfy.id
                                   ){%>
                                       <% check=1; %>
                                   <%}%>
                               <%}%>
                               <% if(check==1){%>
                                   <label><input  type="checkbox" checked name="tags" value="<%=tag[i].id %>"><%=tag[i].name %></label>
                               <%}else{%>													
                                   <label><input  type="checkbox" name="tags" value="<%=tag[i].id %>"><%=tag[i].name %></label>
                           <%}%>
                       <%}%>
                       </div>
                   </div>
               </div>
           </div>
       </div>
       <div class="col-lg-6 col-md-6 col-12">
           <label>Product<span>*</span></label>
           <div class="row mb-2">
               <div class="col-9">
                   <div id="outputcolor"></div>
               </div>
               <div class="col-3 ">
                   <div class="dropdownform">
                       <button type="button" onclick="toggleDropdowncolor()" id="btn1">Select
                           Options</button>
                       <div id="dropdown_content" class="content1">
                           <% for(var i=0; i< product.length; i++){%>
                               <% var check=0; %>
                               <% for(var j=0; j< data.product.length;j++){%>
                                   <% if(product[i].id == data.product[j].productid
                                   ){%>
                                       <% check=1; %>
                                   <%}%>
                               <%}%>
                               <% if(check==1){%>
                                   <label><input  type="checkbox" checked name="tags" value="<%=product[i].id %>"><%=product[i].name %></label>
                               <%}else{%>													
                                   <label><input  type="checkbox" name="tags" value="<%=product[i].id %>"><%=product[i].name %></label>
                           <%}%>
                               <%}%>
                       </div>
                   </div>
               </div>
           </div>
       </div>  
          <button type="submit" class="btn btn-default btn-dark mt-2 mb-2 " >CREATE COUPON</button>
          <button type="button" class="btn btn-dark btn-default " ><a href="/admin/coupon" class="nav-link text-white" >RETURN</a></button> 
       </div>
   </div> 